{
  "name": "pi-dotenvx",
  "version": "0.3.0",
  "description": "pi extension guarding dotenvx private-key files (.env.keys): dormant unless dotenvx detected, sanctions redacted cat/ls",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "dotenvx",
    "security"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit/",
    "test:unit": "bun test test/unit/",
    "test:e2e": "bun run test/e2e/smoke.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
